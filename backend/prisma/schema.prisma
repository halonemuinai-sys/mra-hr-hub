datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPERADMIN
  HR_ADMIN
  RECRUITER
  HIRING_MANAGER
}

enum IntakeSource {
  ATS_RESUME_UPLOAD
  EXCEL_TEMPLATE
  MANUAL_INPUT
}

enum ApplicationStatus {
  APPLIED
  ATS_SCREENED
  SHORTLISTED
  INTERVIEW_HR
  INTERVIEW_USER
  OFFERING
  HIRED
  REJECTED
  TALENT_POOL
}

enum EmploymentStatus {
  PROBATION
  CONTRACT
  PERMANENT
  INTERNSHIP
}

enum AvailabilityStatus {
  IMMEDIATE
  ONE_MONTH_NOTICE
  TWO_MONTH_NOTICE
  OPEN_OFFERS
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(RECRUITER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedApplications JobApplication[]      @relation("ApplicationRecruiter")
  activities           ApplicationActivity[]
  stageRequests        StageRequest[]        @relation("StageRequestRequester")
  stageDecisions       StageRequest[]        @relation("StageRequestDecider")
  managedJobs          JobPosting[]          @relation("JobHiringManager")
  employeesCreated     Employee[]            @relation("EmployeeCreatedBy")
  employeesAnnounced   Employee[]            @relation("EmployeeAnnouncedBy")
}

model JobPosting {
  id               String           @id @default(uuid())
  title            String
  slug             String           @unique
  department       String
  division         String           // MRA Corporate, Retail, Media, F&B
  location         String
  employmentType   String           // Full-time, Contract, Internship
  minExperience    Int              @default(0) // years
  minEducation     String           // SMA/SMK, Diploma, Bachelor, Master
  salaryMin        Decimal?
  salaryMax        Decimal?
  salaryVisibility String           @default("PUBLIC") // PUBLIC, CONFIDENTIAL, UNSPECIFIED
  description      String           @db.Text
  requirements     String           @db.Text
  mustHaveSkills   String[]         // Required skills keywords
  niceToHaveSkills String[]         // Bonus skills keywords
  isActive         Boolean          @default(true)
  // Hiring Manager who owns this job (sees its candidates, confirms hires). Null = any Hiring Manager.
  hiringManagerId  String?
  // Legal entity (PT) within MRA Group that hires for this job
  companyId        String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  applications     JobApplication[]
  hiringManager    User?            @relation("JobHiringManager", fields: [hiringManagerId], references: [id], onDelete: SetNull)
  employees        Employee[]
  company          Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([hiringManagerId])
  @@index([companyId])
}

model Candidate {
  id                 String             @id @default(uuid())
  fullName           String
  email              String             @unique
  phone              String
  location           String?
  headline           String?
  currentCompany     String?
  totalExperienceYrs Float              @default(0)
  expectedSalary     Decimal?
  availability       AvailabilityStatus @default(IMMEDIATE)
  intakeSource       IntakeSource       @default(ATS_RESUME_UPLOAD)
  rawResumePath      String?
  profileSummary     String?            @db.Text

  // Dynamic Grouping Tags
  jobFamily          String?            // IT_DIGITAL, RETAIL, CORPORATE, CREATIVE_MEDIA
  seniorityLevel     String?            // ENTRY, MID, SENIOR, LEAD
  tags               String[]           // ["#TopTier", "#FastTrack", "#RetailExpert"]

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  skills             CandidateSkill[]
  experiences        CandidateExperience[]
  educations         CandidateEducation[]
  applications       JobApplication[]
  employees          Employee[]
}

model CandidateSkill {
  id          String    @id @default(uuid())
  candidateId String
  skillName   String
  category    String    // TECHNICAL, SOFT, TOOLS
  proficiency String    // BEGINNER, INTERMEDIATE, ADVANCED, EXPERT
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

model CandidateExperience {
  id          String    @id @default(uuid())
  candidateId String
  companyName String
  roleTitle   String
  industry    String?
  startDate   DateTime
  endDate     DateTime?
  isCurrent   Boolean   @default(false)
  description String?   @db.Text
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

model CandidateEducation {
  id             String    @id @default(uuid())
  candidateId    String
  institution    String
  degree         String
  major          String
  graduationYear Int?
  gpa            Float?
  candidate      Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

model JobApplication {
  id              String            @id @default(uuid())
  jobId           String
  candidateId     String
  status          ApplicationStatus @default(APPLIED)
  atsScore        Float             @default(0) // 0 - 100
  skillsScore     Float             @default(0)
  expScore        Float             @default(0)
  eduScore        Float             @default(0)
  matchedKeywords String[]
  missingKeywords String[]
  recruiterNotes  String?           @db.Text
  scorecardRating Int?              // 1 to 5 stars
  appliedAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Talent Acquisition ownership (PIC)
  assignedRecruiterId String?
  assignedAt          DateTime?
  stageChangedAt      DateTime          @default(now())
  // Hired and taken off the board (registered as employee, or released manually)
  releasedAt          DateTime?

  job               JobPosting            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate         Candidate             @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  assignedRecruiter User?                 @relation("ApplicationRecruiter", fields: [assignedRecruiterId], references: [id], onDelete: SetNull)
  activities        ApplicationActivity[]
  stageRequests     StageRequest[]
  employee          Employee?

  @@index([assignedRecruiterId])
}

// Audit trail: claim / release / assign / stage moves
model ApplicationActivity {
  id            String         @id @default(uuid())
  applicationId String
  actorId       String?
  action        String         // CLAIM, RELEASE, ASSIGN, STAGE_CHANGE, APPROVAL_REQUESTED, APPROVAL_APPROVED, APPROVAL_REJECTED, APPROVAL_CANCELLED
  fromStatus    String?
  toStatus      String?
  toRecruiterId String?
  note          String?        @db.Text
  stageData     Json?          // form data captured by the stage gate (interview schedule, offer, ...)
  createdAt     DateTime       @default(now())

  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actor         User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([applicationId, createdAt])
}

model TemplateUploadLog {
  id          String   @id @default(uuid())
  fileName    String
  totalRows   Int
  successRows Int
  failedRows  Int
  errorLog    String?  @db.Text
  uploadedBy  String?
  createdAt   DateTime @default(now())
}

// Stage moves that need approval (offer above budget, hire confirmation)
model StageRequest {
  id                 String         @id @default(uuid())
  applicationId      String
  requestedById      String?
  fromStatus         String
  toStatus           String
  stageData          Json?
  reason             String?        @db.Text
  approvalPermission String         // permission key the approver must hold
  approvalReason     String         // why approval is needed (shown to approver)
  status             String         @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED
  decidedById        String?
  decidedAt          DateTime?
  decisionNote       String?        @db.Text
  createdAt          DateTime       @default(now())

  application        JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  requestedBy        User?          @relation("StageRequestRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  decidedBy          User?          @relation("StageRequestDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([applicationId, status])
}

// New hire registered from a HIRED application. Keeps its own copy of the person's data,
// so the record survives deleting the candidate or job.
model Employee {
  id                  String           @id @default(uuid())
  employeeNo          String           @unique // NIK karyawan
  applicationId       String?          @unique
  candidateId         String?
  jobId               String?
  // Employing PT (from the job, can differ)
  companyId           String?
  fullName            String
  personalEmail       String
  workEmail           String?
  phone               String?
  position            String
  department          String
  division            String
  workLocation        String
  employmentStatus    EmploymentStatus @default(PROBATION)
  joinDate            DateTime
  managerName         String?
  notes               String?          @db.Text
  createdById         String?
  // Internal "Selamat Bergabung" announcement
  announcedAt         DateTime?
  announcedById       String?
  announcementMessage String?          @db.Text
  // Talenta (Mekari HRIS) sync — talentaData holds personal & payroll fields (HR only)
  talentaData         Json?
  talentaStatus       String?          // null = not sent, SENT, FAILED
  talentaMode         String?          // mock / sandbox / production the last attempt went to
  talentaUserId       Int?
  talentaEmployeeId   String?
  talentaSyncedAt     DateTime?
  talentaError        String?          @db.Text
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  application         JobApplication?  @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  candidate           Candidate?       @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  job                 JobPosting?      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  company             Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdBy           User?            @relation("EmployeeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  announcedBy         User?            @relation("EmployeeAnnouncedBy", fields: [announcedById], references: [id], onDelete: SetNull)

  @@index([announcedAt])
  @@index([joinDate])
  @@index([companyId])
}

// Legal entities (PT) of MRA Group — managed by Super Admin (company.manage)
model Company {
  id            String       @id @default(uuid())
  code          String       @unique // short code shown in lists, e.g. MRA
  name          String       @unique // PT Mugi Rekso Abadi
  npwp          String?
  address       String?      @db.Text
  // Default Talenta branch for this PT (one Talenta account for the whole group)
  talentaBranch String?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  jobs          JobPosting[]
  employees     Employee[]
}
