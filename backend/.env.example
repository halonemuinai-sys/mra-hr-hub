PORT=5006
NODE_ENV=development
JWT_SECRET=your_jwt_secret_here
CORS_ORIGIN=http://localhost:3006

DATABASE_URL="postgresql://user:password@host:6543/postgres?options=-csearch_path%3Dhr_hub,public&sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/postgres?options=-csearch_path%3Dhr_hub,public&sslmode=require"

GEMINI_API_KEY=""

# Talenta (Mekari HRIS) — send registered employees to Talenta
# off | mock (local simulator, default in development) | sandbox | production
TALENTA_MODE=mock
# HMAC client from Mekari Developer Center (sandbox-developers.mekari.com for sandbox)
TALENTA_HMAC_USERNAME=
TALENTA_HMAC_SECRET=
# Talenta company id for company master-data endpoints ("me" = company of the HMAC client)
TALENTA_COMPANY_ID=me

# E-mail (SMTP via nodemailer) — same Turbify / Yahoo Business account as the MRA Helpdesk
# off | log (default in development: write to backend/mail-outbox, nothing sent) | smtp (default in production when SMTP_USER is set)
MAIL_MODE=log
MAIL_FROM_NAME=MRA Group Recruitment
# Optional: deliver every e-mail to this address instead (testing with real SMTP)
MAIL_REDIRECT_TO=
# Automatic e-mails to applicants (application received, interview invitations); offer letters are sent with a button
MAIL_NOTIFY_APPLICANTS=true
# Public career portal URL used in e-mail links
PORTAL_URL=http://localhost:3006
SMTP_HOST=smtp.bizmail.yahoo.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
