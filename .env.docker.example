# HR HUB — Docker settings. Copy to .env (git-ignored) next to docker-compose.yml and fill in.

# Host port the Nginx container listens on (use e.g. 8080 if port 80 is taken on the server)
HTTP_PORT=80
# API address baked into the frontend at build time. "/api" = same domain via Nginx (recommended).
NEXT_PUBLIC_API_URL=/api

# Database (Supabase) — pooler port 6543 for the app, direct port 5432 for Prisma CLI
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/postgres?sslmode=require"

# Login tokens — a NEW random value, at least 32 characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Public address of this installation (links in e-mails: status page, password reset)
PORTAL_URL=http://hrhub.example.co.id

# E-mail (same SMTP account as the MRA Helpdesk) — off | log | smtp
MAIL_MODE=smtp
MAIL_FROM_NAME=MRA Group Recruitment
MAIL_REDIRECT_TO=
MAIL_NOTIFY_APPLICANTS=true
SMTP_HOST=smtp.bizmail.yahoo.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Talenta (Mekari HRIS) — off | mock | sandbox | production
TALENTA_MODE=off
TALENTA_HMAC_USERNAME=
TALENTA_HMAC_SECRET=
TALENTA_COMPANY_ID=me

# Optional
GEMINI_API_KEY=
